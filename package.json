{
  "name": "grep2rg",
  "version": "0.1.0",
  "description": "GNU grep-compatible searches with an integrated Rust engine and guarded GNU fallback.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Terrydaktal",
    "email": "9lewis9@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Terrydaktal/grep2rg.git"
  },
  "homepage": "https://github.com/Terrydaktal/grep2rg#readme",
  "bugs": {
    "url": "https://github.com/Terrydaktal/grep2rg/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./src/grep-wrapper.mjs",
  "exports": {
    ".": "./src/grep-wrapper.mjs"
  },
  "bin": {
    "grep2rg": "bin/grep2rg",
    "grep2rg-shell-prefix": "bin/grep2rg-shell-prefix.mjs"
  },
  "files": [
    "src/",
    "bin/grep2rg",
    "bin/grep2rg.mjs",
    "bin/grep2rg-shell-prefix.mjs",
    "pi/",
    "docs/",
    "tests/",
    "tools/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "native/",
    "rust/"
  ],
  "scripts": {
    "test": "node tools/verify.mjs",
    "test:core": "node tools/verify.mjs --core",
    "test:deep": "node tools/verify.mjs --deep",
    "prepare": "node tools/build-rust.mjs --optional && node tools/build-native.mjs --optional",
    "postinstall": "node tools/build-rust.mjs --optional && node tools/build-native.mjs --optional",
    "build:native": "node tools/build-native.mjs",
    "build:rust": "node tools/build-rust.mjs",
    "test:rust": "npm run build:rust && node --test tests/test_rust_engine.mjs",
    "benchmark:rust": "node tools/benchmark-rust-engine.mjs"
  },
  "keywords": [
    "grep",
    "ripgrep",
    "compatibility",
    "bash",
    "pi-package"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./pi/grep2rg.ts"
    ]
  }
}
